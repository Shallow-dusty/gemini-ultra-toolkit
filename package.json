{
  "name": "primer-pp",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.js",
    "build:userscript": "node -e \"process.env.TARGET='userscript';require('./scripts/build.js')\"",
    "build:extension": "node -e \"process.env.TARGET='extension';require('./scripts/build.js')\"",
    "test": "c8 node --test --test-concurrency=1",
    "test:fast": "node --test --test-concurrency=1",
    "test:coverage:full": "npm test"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "esbuild": "^0.28.1"
  }
}
